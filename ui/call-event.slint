import { Theme } from "theme.slint";

// A fixed-size history card. No editor, menu, timer or media service.
export component CallEvent inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    in property <string> details;
    in property <string> time;
    in property <bool> outgoing;
    height: 88px;
    card := Rectangle {
        x: root.outgoing ? parent.width - self.width - 10px : 10px;
        y: 4px;width: min(max(1px,parent.width - 36px),300px);height:80px;
        background: root.outgoing ? Theme.outgoing : Theme.panel;
        border-radius:8px;
        Image {
            x:16px;y:18px;width:26px;height:26px;
            source: root.kind == 2 ? @image-url("icons/call-video.svg") : @image-url("icons/call-voice.svg");
            colorize:Theme.secondary;
        }
        Text {
            x:56px;y:12px;width:parent.width - 68px;height:20px;
            text:root.text;color:Theme.text;font-size:14px;overflow:elide;
        }
        Text {
            x:56px;y:34px;width:parent.width - 68px;height:18px;
            text:root.details;color:Theme.secondary;font-size:11px;overflow:elide;
        }
        Text {
            x:12px;y:60px;width:parent.width - 24px;height:14px;
            text:root.time;color:Theme.secondary;font-size:10px;horizontal-alignment:right;
        }
    }
}
