import { Theme } from "theme.slint";
import { IconButton } from "components.slint";
import { SessionButton } from "session.slint";

// Created only after a failed microphone check, once for the whole window.
export component MicrophoneDialog inherits Rectangle {
    callback close();
    background: #0005;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return || event.text == " " {
                root.close();
            }
            return accept;
        }
        panel := Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(520px, root.width - 48px);
            height: content.preferred-height;
            background: Theme.panel;
            border-radius: 18px;
            drop-shadow-offset-y: 8px;
            drop-shadow-blur: 32px;
            drop-shadow-color: Theme.modal-shadow;
            TouchArea { }
            content := VerticalLayout {
                padding: 24px;
                spacing: 24px;
                Text {
                    text: @tr("Microphone not found");
                    color: Theme.text;
                    font-size: 24px;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                Text {
                    text: @tr("You can't record a voice message because no microphone is available. Connect a microphone and try again. If one is already connected, check the microphone selection in Settings → Audio and your system's microphone permissions.");
                    color: Theme.secondary;
                    font-size: 14px;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                Rectangle { height: 24px; }
                HorizontalLayout {
                    alignment: end;
                    SessionButton {
                        width: 116px;
                        height: 42px;
                        label: @tr("OK, got it");
                        activated => { root.close(); }
                    }
                }
            }
        }
    }
}

export component VoiceRecorder inherits Rectangle {
    in property <int> phase;
    in property <string> time;
    in property <string> waveform;
    in property <string> status;
    in property <bool> playing;
    in property <bool> can-send;
    callback control(int);
    FocusScope {
        init=>{self.focus();}
        key-pressed(event)=>{if event.text==Key.Escape {if root.phase!=5 {root.control(1);}return accept;}if event.text==Key.Return{return accept;}return reject;}
        HorizontalLayout {
            padding-left:6px;padding-right:6px;spacing:6px;
            IconButton{icon:@image-url("icons/trash.svg");label:@tr("Discard voice recording");enabled:root.phase!=3 && root.phase!=5;activated=>{root.control(1);}}
            if root.phase==1:Rectangle {
                width:6px;
                Rectangle {y:(parent.height - 6px) / 2;width:6px;height:6px;border-radius:3px;background:#e45b63;}
            }
            Text {width:42px;text:root.time;color:Theme.secondary;vertical-alignment:center;horizontal-alignment:center;font-size:13px;}
            if root.width>=300px:Rectangle {
                horizontal-stretch:1;
                Path{x:0px;y:(parent.height - 30px) / 2;width:parent.width;height:30px;viewbox-width:192;viewbox-height:30;fit:fill;commands:root.waveform;fill:Theme.accent;}
            }
            if root.width<300px:Rectangle {horizontal-stretch:1;}
            if root.phase==1 || root.phase==2:IconButton {
                icon:root.phase==1 ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                label:root.phase==1 ? @tr("Pause recording") : @tr("Resume recording");activated=>{root.control(2);}
            }
            if root.phase==1 || root.phase==2:IconButton {icon:@image-url("icons/stop.svg");label:@tr("Stop recording and review");activated=>{root.control(3);}}
            if root.phase==4:IconButton {
                icon:root.playing ? @image-url("icons/stop.svg") : @image-url("icons/play.svg");
                label:root.playing ? @tr("Stop voice preview") : @tr("Play voice preview");activated=>{root.control(4);}
            }
            if root.phase==4:IconButton {icon:@image-url("icons/send.svg");label:@tr("Send voice message");filled:true;enabled:root.can-send;activated=>{root.control(5);}}
        }
    }
}
