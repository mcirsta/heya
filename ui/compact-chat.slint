import { Theme } from "theme.slint";
import { Avatar } from "components.slint";

// ZapFast chats.rs compact_row geometry; Heya supplies the existing chat model.
export component CompactChat inherits Rectangle {
    in property <string> title;
    in property <string> initials;
    in property <color> tint;
    in property <image> picture;
    in property <int> unread;
    in property <bool> marked-unread;
    in property <bool> selected;
    callback activated();
    height: 52px;
    accessible-role: button;
    accessible-label: root.title + (root.unread > 0 ? ", " + root.unread + " unread" : root.marked-unread ? ", marked unread" : "");
    accessible-action-default => { root.activated(); }
    Rectangle {
        x: (parent.width - 48px) / 2;
        y: 2px;
        width: 48px;
        height: 48px;
        border-radius: 10px;
        background: hit.has-hover ? Theme.hover : transparent;
        border-color: Theme.accent;
        border-width: focus.has-focus ? 1px : 0px;
    }

    avatar := Avatar {
        x: (parent.width - 36px) / 2;
        y: 8px;
        width: 36px;
        height: 36px;
        initials: root.initials;
        tint: root.tint;
        picture: root.picture;
    }

    if root.selected: Rectangle {
        x: 1px;
        y: 15px;
        width: 3px;
        height: 22px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    badge := Rectangle {
        visible: root.unread > 0 || root.marked-unread;
        x: avatar.x + avatar.width - 6px - self.width / 2;
        y: 0px;
        width: root.unread == 0 ? 10px : max(20px, count.preferred-width + 12px);
        height: root.unread == 0 ? 10px : 20px;
        border-radius: 10px;
        background: Theme.accent;
        count := Text {
            text: root.unread == 0 ? "" : root.unread > 99 ? "99+" : root.unread;
            color: Theme.on-accent;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }

    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.activated(); }
    }

    Tooltip {
        Rectangle {
            width: min(300px, name.preferred-width + 16px);
            height: name.preferred-height + 12px;
            background: Theme.surface;
            border-color: Theme.outline;
            border-width: 1px;
            border-radius: 4px;
            name := Text {
                x: 8px;
                y: 6px;
                width: parent.width - 16px;
                text: root.title;
                color: Theme.text;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}
