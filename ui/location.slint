import { Theme, Metrics } from "theme.slint";
import { ContentTarget } from "message-content.slint";

export component LocationCard inherits Rectangle {
    in property <string> name;
    in property <string> address;
    in property <string> domain;
    in property <string> coordinates;
    in property <image> thumbnail;
    callback activate(int);
    height: Metrics.location-height(root.name!="",root.address!="",root.domain!="");
    ContextMenuArea {
        Menu {
            MenuItem { title:@tr("Open in Maps"); activated=>{root.activate(-20);} }
            MenuItem { title:@tr("Copy location link"); activated=>{root.activate(-21);} }
            MenuItem { title:@tr("Copy coordinates"); activated=>{root.activate(-22);} }
            if root.address!="":MenuItem { title:@tr("Copy address"); activated=>{root.activate(-23);} }
            if root.domain!="":MenuItem { title:@tr("Open place website"); activated=>{root.activate(-24);} }
        }
        map := Rectangle {
            x:0px;y:0px;width:parent.width;height:150px;
            background:Theme.surface;border-radius:6px;clip:true;
            Image {width:100%;height:100%;source:root.thumbnail;image-fit:cover;}
            // The map is centred on the pin's tip, including on HiDPI displays.
            Image {x:(parent.width - 26px)/2;y:parent.height/2 - 32px;width:26px;height:32px;source:@image-url("icons/location-pin.svg");}
            ContentTarget {
                label:@tr("Open in Maps") + " · " + root.coordinates;
                activated=>{root.activate(-20);} copy=>{root.activate(-21);}
            }
            if root.thumbnail.width>0: attribution := Rectangle {
                x:parent.width - self.width;y:parent.height - self.height;
                width:min(parent.width,credit.preferred-width+8px);height:credit.preferred-height + 4px;background:#ffffffe8;
                credit:=Text {x:4px;y:2px;width:parent.width - 8px;height:self.preferred-height;text:"© OpenStreetMap contributors";font-size:9px;color:#333;wrap:word-wrap;}
                ContentTarget {label:"© OpenStreetMap contributors";activated=>{root.activate(-25);}}
            }
        }
        title := Text {
            visible:root.name!="";x:6px;y:156px;width:parent.width - 12px;height:22px;
            text:root.name;color:Theme.link;font-size:14px;font-weight:600;overflow:elide;
        }
        if root.name!="":ContentTarget {
            x:title.x;y:title.y;width:title.width;height:title.height;label:root.name;
            activated=>{root.activate(root.domain!="" ? -24 : -20);} copy=>{root.activate(-21);}
        }
        address := TextInput {
            visible:root.address!="";x:6px;y:154px + (root.name!="" ? 28px : 0px);
            width:parent.width - 12px;height:36px;text:root.address;
            color:Theme.secondary;font-size:12px;read-only:true;single-line:false;wrap:word-wrap;
        }
        if root.domain!="":Text {
            x:6px;y:parent.height - 20px;width:parent.width - 12px;height:18px;
            text:root.domain;font-size:11px;color:Theme.dim;overflow:elide;
        }
    }
}
