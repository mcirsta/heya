import { Theme } from "theme.slint";
import { ContentTarget } from "message-content.slint";
import { IconButton } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// Loading keeps the available image unobstructed. Only manual download and
// failure states need an overlay; no viewer or nested scroll area in chat rows.
export component PhotoTile inherits Rectangle {
    in property <image> picture;
    in property <int> state;
    in property <string> status;
    in property <bool> crop;
    in property <string> label;
    in property <bool> show-status: true;
    in property <bool> auto-download-photos: true;
    callback activated();
    border-radius: 6px; clip: true; background: Theme.surface;
    Image { width: parent.width; height: parent.height; source: root.picture; image-fit: root.crop ? cover : contain; }
    if root.show-status && (root.state>=3 || (root.state==0 && !root.auto-download-photos)): status-disc := Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: 44px; height: 44px; border-radius: 22px; background: #0008;
        Image {
            x: 11px; y: 11px; width: 22px; height: 22px;
            source: root.state == 0 ? @image-url("icons/photo-download.svg") : @image-url("icons/photo-retry.svg");
        }
    }
    ContentTarget {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        label: root.label!="" ? root.label : root.state == 2 ? @tr("Open photo") : root.status;
        activated => { root.activated(); }
    }
}

export struct AlbumPhotoRow {id:int,time:string,picture:image,state:int,status:string}

export component PhotoGrid inherits Rectangle {
    in property <[AlbumPhotoRow]> photos;
    in property <int> more;
    in property <bool> auto-download-photos: true;
    callback activated(int);
    callback hovered(int);
    private property <length> gap: 4px;
    private property <length> half: (root.width - root.gap) / 2;
    for photo[i] in root.photos: cell := Rectangle {
        x: root.photos.length==3 ? (i==0 ? 0px : root.half + root.gap) : mod(i,2)*(root.half + root.gap);
        y: root.photos.length==3 ? (i==2 ? (root.height+root.gap)/2 : 0px) : floor(i/2)*(root.half + root.gap);
        width: root.half;
        height: root.photos.length==3 && i==0 ? root.height : (root.photos.length==3 ? (root.height - root.gap)/2 : root.half);
        border-radius:6px;clip:true;
        hover := TouchArea {
        width:parent.width;height:parent.height;
        changed has-hover=>{if self.has-hover {root.hovered(photo.id);}}
        moved=>{root.hovered(photo.id);}
        PhotoTile {width:parent.width;height:parent.height;picture:photo.picture;state:photo.state;status:photo.status;crop:true;
            auto-download-photos:root.auto-download-photos;
            show-status:i+1<root.photos.length || root.more==0;
            label:i+1==root.photos.length && root.more>0 ? @tr("Show {} more photos",root.more) : @tr("Open photo");activated=>{root.activated(photo.id);}}
        if i+1==root.photos.length && root.more>0:Rectangle {
            width:parent.width;height:parent.height;background:#0007;
            Text {width:parent.width;height:parent.height;text:"+"+root.more;font-size:min(38px,parent.width*0.24);font-weight:500;color:white;horizontal-alignment:center;vertical-alignment:center;}
        }
        Rectangle {
            x:0px;y:parent.height - self.height;width:parent.width;height:28px;
            background:@linear-gradient(180deg,transparent 0%,#0008 100%);
            Text {x:4px;y:7px;width:parent.width - 10px;height:17px;text:photo.time;color:white;font-size:11px;horizontal-alignment:right;overflow:elide;}
        }
        }
    }
}

// The gallery exists only while open. Seven small cached thumbnails surround
// the selection; full-size pixels belong only to the current photo.
export struct PhotoThumbnail { id: int, picture: image, key: string }

component ViewerButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback activated();
    width: 40px; height: 40px; border-radius: 20px;
    background: area.has-hover && root.enabled ? Theme.hover : transparent;
    opacity: root.enabled ? 1 : 0.32;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => {if root.enabled {root.activated();}}
    border-width: focus.has-focus ? 1px : 0px; border-color: Theme.accent;
    Image {x: 9px; y: 9px; width: 22px; height: 22px; source: root.icon; colorize: Theme.secondary;}
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {root.activated(); return accept;}
            return reject;
        }
    }
    area := TouchArea {enabled: root.enabled; mouse-cursor: pointer; clicked => {focus.focus();root.activated();}}
}

export component PhotoViewer inherits Rectangle {
    in property <int> photo-id;
    in property <image> picture;
    in property <string> status;
    in property <bool> ready;
    in property <string> sender;
    in property <string> date;
    in property <string> caption;
    in property <string> counter;
    in property <int> previous-id;
    in property <int> next-id;
    in property <[PhotoThumbnail]> thumbnails;
    callback navigate(int);
    callback closed();
    callback retry();
    callback copy();
    private property <bool> zoomed;
    changed photo-id => {root.zoomed=false; viewport.content-x=0px; viewport.content-y=0px;}
    private property <bool> album: root.thumbnails.length>1;
    private property <length> thumb-size: min(64px, (root.width - 32px - max(0,root.thumbnails.length - 1) * 8px) / max(1,root.thumbnails.length));
    private property <length> caption-height: root.caption=="" ? 0px : min(76px, caption-text.preferred-height + 12px);
    private property <length> footer-height: root.caption-height + (root.album ? root.thumb-size + 36px : 0px) + 40px;
    background: Theme.panel;
    TouchArea {clicked => {}}
    focus := FocusScope {
        init => {self.focus();}
        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.meta) && event.text == "c" && root.ready {root.copy();return accept;}
            if event.text == Key.Escape {root.closed();return accept;}
            if event.text == Key.LeftArrow {if root.previous-id>0 {root.navigate(root.previous-id);} return accept;}
            if event.text == Key.RightArrow {if root.next-id>0 {root.navigate(root.next-id);} return accept;}
            if event.text == " " {if root.ready {root.zoomed=!root.zoomed;} return accept;}
            return reject;
        }
        header := Rectangle {
            x: 0px; y: 0px; height: 72px; width: parent.width;
            background: Theme.panel;
            Rectangle {x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.outline;}
            Rectangle {
                x: 20px; y: 16px; width: 40px; height: 40px; border-radius: 20px; background: Theme.accent.with-alpha(0.12);
                Image {x: 10px; y: 10px; width: 20px; height: 20px; source: @image-url("icons/photo.svg"); colorize: Theme.accent;}
            }
            Text {x: 72px; y: 14px; width: max(1px,parent.width - 228px); height: 24px; text: root.sender=="" ? @tr("Photo") : root.sender; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide;}
            Text {x: 72px; y: 39px; width: max(1px,parent.width - 228px); height: 18px; text: root.date; color: Theme.secondary; font-size: 12px; overflow: elide;}
            ViewerButton {x: parent.width - 144px; y: 16px; icon: @image-url("icons/copy.svg"); label: @tr("Copy image"); enabled: root.ready; activated => {root.copy();}}
            ViewerButton {x: parent.width - 96px; y: 16px; icon: root.zoomed ? @image-url("icons/viewer-fit.svg") : @image-url("icons/viewer-zoom.svg"); label: root.zoomed ? @tr("Fit photo") : @tr("Zoom photo"); enabled: root.ready; activated => {root.zoomed=!root.zoomed;}}
            ViewerButton {x: parent.width - 48px; y: 16px; icon: @image-url("icons/close.svg"); label: @tr("Close photo"); activated => {root.closed();}}
        }
        stage := Rectangle {
            x: 0px; y: header.height; width: parent.width; height: max(40px,parent.height - header.height - root.footer-height);
            viewport := ScrollView {
                x: root.album ? 64px : 24px; y: 16px; width: max(1px,parent.width - 2 * self.x); height: max(1px,parent.height - 32px);
                content-width: root.zoomed ? max(self.visible-width,root.picture.width * 1px) : self.visible-width;
                content-height: root.zoomed ? max(self.visible-height,root.picture.height * 1px) : self.visible-height;
                Image {width: parent.content-width; height: parent.content-height; source: root.picture; image-fit: contain;}
            }
            if root.album: previous := ViewerButton {
                x: 12px; y: (parent.height - self.height)/2; icon: @image-url("icons/viewer-previous.svg");
                label: @tr("Previous photo"); enabled: root.previous-id>0; activated => {root.navigate(root.previous-id);}
            }
            if root.album: next := ViewerButton {
                x: parent.width - self.width - 12px; y: (parent.height - self.height)/2; icon: @image-url("icons/viewer-next.svg");
                label: @tr("Next photo"); enabled: root.next-id>0; activated => {root.navigate(root.next-id);}
            }
            if !root.ready && root.status!="": issue := Rectangle {
                x: max(64px,(parent.width - self.width)/2); y: (parent.height - self.height)/2;
                width: min(340px,parent.width - 128px); height: 52px; border-radius: 26px;
                background: Theme.panel; border-width: 1px; border-color: Theme.outline;
                Text {x: 16px; width: parent.width - 32px; height: parent.height; text: root.status; font-size: 13px; color: Theme.secondary; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;}
                ContentTarget {width: parent.width; height: parent.height; border-radius: 26px; label: root.status; activated => {root.retry();}}
            }
        }
        footer := Rectangle {
            x: 0px; y: parent.height - root.footer-height; width: parent.width; height: root.footer-height;
            caption-scroll := ScrollView {
                x: max(24px,(parent.width - 760px)/2); y: 0px; width: min(760px,parent.width - 48px); height: root.caption-height;
                content-width: self.visible-width; content-height: caption-text.preferred-height;
                caption-text := Text {x: 0px; y: 0px; height: self.preferred-height; width: parent.visible-width; text: root.caption; wrap: word-wrap; color: Theme.text; font-size: 14px; horizontal-alignment: center;}
            }
            if root.album: strip := Rectangle {
                x: (parent.width - self.width)/2; y: root.caption-height + 12px;
                width: root.thumbnails.length * root.thumb-size + max(0,root.thumbnails.length - 1)*8px; height: root.thumb-size + 8px;
                for thumbnail[i] in root.thumbnails: thumb := Rectangle {
                    x: i * (root.thumb-size + 8px); width: root.thumb-size; height: root.thumb-size;
                    border-radius: 8px; border-width: thumbnail.id==root.photo-id ? 3px : 1px;
                    border-color: thumbnail.id==root.photo-id ? Theme.accent : Theme.outline;
                    background: Theme.surface;
                    opacity: thumbnail.id==root.photo-id || area.has-hover ? 1 : 0.65;
                    Image {x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 10px; source: thumbnail.picture.width>0 ? thumbnail.picture : @image-url("icons/photo.svg"); colorize: thumbnail.picture.width>0 ? transparent : Theme.secondary; image-fit: contain;}
                    accessible-role: button; accessible-label: @tr("View album photo"); accessible-action-default => {root.navigate(thumbnail.id);}
                    area := TouchArea {mouse-cursor: pointer; clicked => {focus.focus();root.navigate(thumbnail.id);}}
                }
            }
            Text {x: 24px; y: parent.height - 30px; width: parent.width - 48px; height: 20px; text: root.counter; font-size: 12px; color: Theme.secondary; horizontal-alignment: center;}
        }
    }
}
