import { ScrollView, ListView, AboutSlint, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconButton } from "components.slint";

export struct AudioDeviceRow {id:string,name:string,input:bool}
export struct SettingRow {
    key: string,
    title: string,
    description: string,
    // 0 switch, 1 choice, 2 unfinished, 3 information, 4 action, 5 volume
    kind: int,
    options: [string],
    value: int,
    action: string,
}
export struct SettingSection { title: string, rows: [SettingRow] }

export component SoftButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback activated();
    height: 30px;
    min-width: label.preferred-width + 24px;
    background: hit.has-hover && enabled ? Theme.hover : Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : Theme.outline;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.activated(); } }
    label := Text {
        text: root.text;
        color: root.enabled ? Theme.text : Theme.dim;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.activated(); return accept; } return reject; }
    }

    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.activated(); }
    }
}

export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled();
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: checked ? Theme.accent : Theme.selected;
    border-width: focus.has-focus ? 2px : checked ? 0px : 1.5px;
    border-color: focus.has-focus ? Theme.accent : Theme.secondary;
    accessible-role: checkbox;
    accessible-label: label;
    accessible-checked: checked;
    accessible-action-default => { root.toggled(); }
    Rectangle {
        width: root.checked ? 16px : 12px;
        height: self.width;
        x: (root.checked ? 29px : 11px) - self.width / 2;
        y: (parent.height - self.height) / 2;
        background: root.checked ? white : Theme.secondary;
        border-radius: self.width / 2;
        if root.checked: Image {
            x: 2px;
            y: 2px;
            width: 12px;
            height: 12px;
            source: @image-url("icons/check.svg");
            colorize: Theme.accent;
        }
    }

    focus := FocusScope {
        key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.toggled(); return accept; } return reject; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.toggled(); }
    }
}

component Choice inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <string> label;
    callback chosen(int);
    private property <int> highlighted;
    public function open() { root.highlighted = root.selected; popup.show(); }
    height: 30px;
    width: 200px;
    background: area.has-hover ? Theme.hover : Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : Theme.outline;
    accessible-role: button;
    accessible-label: label + ": " + options[selected];
    accessible-action-default => { root.open(); }
    Text {
        x: 8px;
        width: parent.width - 36px;
        height: parent.height;
        text: root.options[root.selected];
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }

    Image {
        x: parent.width - 24px;
        y: 7px;
        width: 16px;
        height: 16px;
        source: @image-url("icons/chevron-down.svg");
        colorize: Theme.secondary;
    }

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.open(); return accept; }
            if event.text == Key.DownArrow { root.chosen(min(root.options.length - 1, root.selected + 1)); return accept; }
            if event.text == Key.UpArrow { root.chosen(max(0, root.selected - 1)); return accept; }
            return reject;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.open(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: min(320px, root.options.length * 32px + 12px);
        Rectangle {
            background: Theme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.outline;
            drop-shadow-offset-y: 6px;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.modal-shadow;
            FocusScope {
                init => { self.focus(); }
                key-pressed(event) => {
                    if event.text == Key.Escape { popup.close(); return accept; }
                    if event.text == Key.Return || event.text == " " { root.chosen(root.highlighted); popup.close(); return accept; }
                    if event.text == Key.DownArrow || event.text == Key.UpArrow {
                        root.highlighted = clamp(root.highlighted + (event.text == Key.DownArrow ? 1 : -1),0,root.options.length - 1);
                        choice-list.content-y = min(0px,max(choice-list.visible-height - choice-list.content-height,choice-list.visible-height - (root.highlighted + 1) * 32px));
                        return accept;
                    }
                    return reject;
                }
                choice-list := ListView {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    height: parent.height - 12px;
                    for label[index] in root.options: Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: index == root.highlighted ? Theme.selected : choice-hit.has-hover ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: label;
                        accessible-action-default => { root.chosen(index); popup.close(); }
                        Text {
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            text: label;
                            color: Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        FocusScope {
                            key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.chosen(index); popup.close(); return accept; } if event.text == Key.Escape { popup.close(); return accept; } return reject; }
                        }

                        choice-hit := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.chosen(index); popup.close(); }
                        }
                    }
                }
            }
        }
    }
}

component SettingsRow inherits Rectangle {
    in property <SettingRow> entry;
    callback changed(string, int);
    private property <bool> stacked: self.width < 400px;
    height: max(30px, labels.preferred-height) + (stacked && entry.kind != 3 ? 38px : 0px) + 10px;
    labels := VerticalLayout {
        x: 0px;
        y: 0px;
        width: root.stacked || root.entry.kind == 3 ? root.width : max(120px, root.width - 260px);
        height: self.preferred-height;
        spacing: 2px;
        Text {
            text: root.entry.title;
            color: Theme.text;
            font-size: 14px;
            font-weight: 500;
            wrap: word-wrap;
        }

        if root.entry.description != "": Text {
            text: root.entry.description;
            color: Theme.secondary;
            font-size: 12.5px;
            wrap: word-wrap;
        }
    }

    control := Rectangle {
        x: parent.width - self.width;
        y: root.stacked ? labels.height + 8px : max(0px,(labels.height - 30px) / 2);
        width: min(parent.width, 220px);
        height: 30px;
        if root.entry.kind == 0: Switch {
            x: parent.width - self.width;
            y: 4px;
            checked: root.entry.value == 1;
            label: root.entry.title;
            toggled => { root.changed(root.entry.key, root.entry.value == 1 ? 0 : 1); }
        }
        if root.entry.kind == 1: Choice {
            x: parent.width - self.width;
            width: min(200px, parent.width);
            options: root.entry.options;
            selected: root.entry.value;
            label: root.entry.title;
            chosen(value) => { root.changed(root.entry.key,value); }
        }
        if root.entry.kind == 2: SoftButton {
            x: parent.width - self.width;
            text: @tr("Not implemented yet");
            enabled: false;
        }
        if root.entry.kind == 5: HorizontalLayout {
            spacing:8px;
            slider:=Slider {minimum:0;maximum:100;value:root.entry.value;accessible-label:root.entry.title;changed(value)=>{root.changed(root.entry.key,round(value));}}
            Text{width:38px;text:round(slider.value) + "%";color:Theme.secondary;vertical-alignment:center;font-size:12px;}
        }
        if root.entry.kind == 4: SoftButton {
            x: parent.width - self.width;
            text: root.entry.action;
            activated => { root.changed(root.entry.key,0); }
        }
    }
}

component SettingsTab inherits Rectangle {
    in property <string> title;
    in property <int> index;
    in property <bool> selected;
    in property <bool> focused;
    callback activate();
    callback focus-tab();
    callback step(int);
    height: 42px;
    border-radius: 8px;
    background: root.selected ? Theme.accent.with-alpha(0.12) : hit.has-hover ? Theme.hover : transparent;
    border-width: tab-focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: tab;
    accessible-label: root.title;
    accessible-item-index: root.index;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => {tab-focus.focus();root.activate();}
    if root.selected: Rectangle {x:0px;y:11px;width:3px;height:20px;border-radius:2px;background:Theme.accent;}
    Text {
        x:14px;width:parent.width - 28px;height:parent.height;
        text:root.title;color:root.selected ? Theme.accent : Theme.text;
        font-size:14px;font-weight:root.selected ? 600 : 400;
        vertical-alignment:center;overflow:elide;
    }
    changed focused=>{if root.focused {tab-focus.focus();}}
    tab-focus:=FocusScope {
        changed has-focus=>{if self.has-focus {root.focus-tab();}}
        key-pressed(event)=>{
            if event.text==Key.Return || event.text==" " {root.activate();return accept;}
            if event.text==Key.DownArrow {root.step(1);return accept;}
            if event.text==Key.UpArrow {root.step(-1);return accept;}
            return reject;
        }
    }
    hit:=TouchArea {mouse-cursor:pointer;clicked=>{tab-focus.focus();root.activate();}}
}

component SettingsSectionView inherits VerticalLayout {
    in property <SettingSection> section;
    callback changed(string,int);
    spacing:12px;
    accessible-role:tab-panel;
    accessible-label:root.section.title;
    Text {text:root.section.title;font-size:21px;font-weight:600;color:Theme.text;wrap:word-wrap;}
    card:=Rectangle {
        height:rows.preferred-height;
        background:Theme.panel.mix(Theme.surface,0.5);
        border-radius:12px;border-width:1px;border-color:Theme.outline;
        rows:=VerticalLayout {
            padding:20px;padding-bottom:10px;spacing:4px;
            for row in root.section.rows:SettingsRow {
                entry:row;changed(key,value)=>{root.changed(key,value);}
            }
        }
    }
    if root.section.title=="About":AboutSlint {}
}

export component SettingsPage inherits Rectangle {
    in property <[SettingSection]> sections;
    in property <[string]> categories;
    in-out property <int> selected-tab;
    in property <string> status;
    in-out property <string> query;
    callback search(string);
    callback changed(string,int);
    callback back();
    private property <bool> searching: root.query!="";
    private property <bool> side-tabs: root.width>=600px;
    private property <length> nav-width: root.side-tabs ? 184px : 0px;
    private property <length> body-top: !root.side-tabs && !root.searching ? 170px : 124px;
    private property <int> focused-tab: -1;
    background:Theme.panel;
    init=>{settings-search.focus();}
    changed selected-tab=>{settings-scroll.content-y=0px;}
    changed query=>{settings-scroll.content-y=0px;}
    public function choose-tab(index:int) {
        if index>=0 && index<root.categories.length {
            root.query="";root.search("");root.selected-tab=index;
            settings-scroll.content-y=0px;
        }
    }
    header:=HorizontalLayout {
        x:24px;y:20px;width:root.width - 48px;height:34px;spacing:8px;
        IconButton {icon:@image-url("icons/back.svg");icon-size:20px;label:@tr("Back (Esc)");activated=>{root.back();}}
        Text {text:@tr("Settings");font-size:24px;font-weight:700;color:Theme.text;vertical-alignment:center;horizontal-stretch:1;}
    }
    search-field:=Rectangle {
        x:24px;y:68px;width:min(1040px,root.width - 48px);height:36px;
        background:Theme.surface;border-radius:18px;
        border-width:settings-search.has-focus ? 1px : 0px;border-color:Theme.accent;
        Image {x:12px;y:10px;width:16px;height:16px;source:@image-url("icons/search.svg");colorize:Theme.secondary;}
        Text {x:36px;width:parent.width - 66px;height:parent.height;text:@tr("Search all settings");color:Theme.dim;visible:root.query=="";vertical-alignment:center;overflow:elide;}
        settings-search:=TextInput {
            x:36px;width:parent.width - 68px;height:parent.height;
            text<=>root.query;color:Theme.text;single-line:true;vertical-alignment:center;
            accessible-label:@tr("Search settings");
            edited=>{root.search(self.text);}
        }
        if root.query!="":IconButton {
            x:parent.width - 30px;y:6px;width:24px;height:24px;icon-size:15px;
            icon:@image-url("icons/close.svg");label:@tr("Clear settings search");
            activated=>{root.query="";root.search("");settings-search.focus();}
        }
    }
    if root.side-tabs: navigation:=Rectangle {
        x:0px;y:124px;width:root.nav-width;height:parent.height - self.y;
        Rectangle {x:parent.width - 1px;width:1px;height:parent.height;background:Theme.outline;}
        nav-scroll:=ScrollView {
            width:parent.width - 1px;height:parent.height;
            content-width:self.visible-width;content-height:tabs.preferred-height;
            horizontal-scrollbar-policy:always-off;
            tabs:=VerticalLayout {
                padding-left:16px;padding-right:16px;padding-bottom:16px;spacing:4px;
                accessible-role:tab-list;accessible-label:@tr("Settings categories");
                for title[index] in root.categories:SettingsTab {
                    title:title;index:index;selected:!root.searching && root.selected-tab==index;
                    focused:root.focused-tab==index;
                    focus-tab=>{root.focused-tab=index;}
                    activate=>{root.choose-tab(index);}
                    step(direction)=>{
                        let next=clamp(index+direction,0,root.categories.length - 1);
                        root.focused-tab=next;root.choose-tab(next);
                        if next*46px+nav-scroll.content-y<0px {nav-scroll.content-y=-next*46px;}
                        else if next*46px+42px+nav-scroll.content-y>nav-scroll.visible-height {nav-scroll.content-y=nav-scroll.visible-height - next*46px - 42px;}
                    }
                }
            }
        }
    }
    if !root.side-tabs && !root.searching:Choice {
        x:24px;y:122px;width:parent.width - 48px;
        label:@tr("Settings category");options:root.categories;selected:root.selected-tab;
        chosen(index)=>{root.choose-tab(index);}
    }
    settings-scroll:=ScrollView {
        x:root.nav-width;y:root.body-top;width:root.width - self.x;height:max(0px,root.height - self.y);
        content-width:self.visible-width;content-height:column.preferred-height+24px;
        horizontal-scrollbar-policy:always-off;
        column:=VerticalLayout {
            x:24px;y:0px;width:max(0px,min(856px,settings-scroll.visible-width - 48px));
            height:self.preferred-height;spacing:20px;
            if root.status!="":Text {text:root.status;wrap:word-wrap;color:Theme.secondary;font-size:12.5px;}
            if root.searching:VerticalLayout {
                spacing:24px;
                Text {text:@tr("Search results · All settings");font-size:14px;font-weight:600;color:Theme.secondary;wrap:word-wrap;}
                for section in root.sections:SettingsSectionView {section:section;changed(key,value)=>{root.changed(key,value);}}
                if root.sections.length==0:Text {text:@tr("No settings match your search.");color:Theme.secondary;wrap:word-wrap;}
            }
            if !root.searching && root.selected-tab<root.sections.length:SettingsSectionView {
                section:root.sections[root.selected-tab];changed(key,value)=>{root.changed(key,value);}
            }
        }
    }
}
