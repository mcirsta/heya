import { Theme } from "theme.slint";
import { ContentTarget } from "message-content.slint";

export global VideoPlayback {
    in property <int> id;
    in property <int> state;
    in property <image> frame;
    in property <int> frame-number;
    in property <float> fraction;
    in property <string> time;
    in property <string> error;
    in property <bool> muted;
}

component VideoButton inherits Rectangle {
    in property <int> kind;
    in property <string> label;
    callback activated();
    width:30px;height:30px;border-radius:15px;background:transparent;
    Path {
        x:7px;y:7px;width:16px;height:16px;viewbox-width:24;viewbox-height:24;
        commands:root.kind==0 ? "M 7 3 L 21 12 L 7 21 Z" : root.kind==1 ? "M 5 3 H 10 V 21 H 5 Z M 15 3 H 20 V 21 H 15 Z" : root.kind==2 || root.kind==3 ? "M 3 9 H 7 L 13 4 V 20 L 7 15 H 3 Z" : "";
        fill:white;
    }
    Path {
        x:7px;y:7px;width:16px;height:16px;viewbox-width:24;viewbox-height:24;
        commands:root.kind==2 ? "M 17 7 Q 24 12 17 17" : root.kind==3 ? "M 17 9 L 23 15 M 23 9 L 17 15" : root.kind==4 ? "M 3 9 V 3 H 9 M 15 3 H 21 V 9 M 21 15 V 21 H 15 M 9 21 H 3 V 15" : root.kind==5 ? "M 3 8 H 8 V 3 M 16 3 V 8 H 21 M 21 16 H 16 V 21 M 8 21 V 16 H 3" : "M 5 5 L 19 19 M 19 5 L 5 19";
        stroke:root.kind>=2 ? white : transparent;stroke-width:2px;fill:transparent;
    }
    target:=ContentTarget {width:parent.width;height:parent.height;label:root.label;activated=>{root.activated();}}
}

export component VideoControls inherits Rectangle {
    in property <bool> expanded;
    callback control(int,float);
    height:38px;background:#000b;
    VideoButton {
        x:3px;y:4px;kind:VideoPlayback.state==2 ? 1 : 0;
        label:VideoPlayback.state==2 ? @tr("Pause video") : @tr("Play video");
        activated=>{root.control(0,0);}
    }
    Text {
        x:38px;y:2px;height:20px;width:parent.width - 114px;
        text:VideoPlayback.time;color:white;font-size:11px;vertical-alignment:center;overflow:elide;
    }
    seek:=Rectangle {
        x:40px;y:26px;width:max(10px,parent.width - 120px);height:3px;background:#fff6;border-radius:1.5px;
        Rectangle {width:parent.width * VideoPlayback.fraction;height:parent.height;background:Theme.accent;}
        Rectangle {x:clamp(parent.width * VideoPlayback.fraction - 4px,0px,parent.width - 8px);y:-2.5px;width:8px;height:8px;border-radius:4px;background:white;}
    }
    seek-target:=TouchArea {
        x:seek.x - 3px;y:16px;width:seek.width+6px;height:22px;mouse-cursor:pointer;
        pointer-event(event)=>{if event.kind==PointerEventKind.up {root.control(1,clamp((self.mouse-x - 3px)/seek.width,0,1));}}
    }
    VideoButton {
        x:parent.width - 67px;y:4px;kind:VideoPlayback.muted ? 3 : 2;
        label:VideoPlayback.muted ? @tr("Unmute video") : @tr("Mute video");
        activated=>{root.control(2,0);}
    }
    VideoButton {
        x:parent.width - 34px;y:4px;kind:root.expanded ? 5 : 4;
        label:root.expanded ? @tr("Back to message") : @tr("Expand video");
        activated=>{root.control(4,0);}
    }
}

export component VideoTile inherits Rectangle {
    in property <int> message-id;
    in property <image> poster;
    in property <string> duration;
    in property <bool> expanded;
    callback control(int,float);
    private property <bool> active:VideoPlayback.id==root.message-id;
    private property <int> state:root.active ? VideoPlayback.state : 0;
    border-radius:6px;clip:true;background:#182229;
    Image {width:parent.width;height:parent.height;image-fit:contain;
        source:root.active && VideoPlayback.frame.width>0 ? VideoPlayback.frame : root.poster;
    }
    if root.state!=2 && root.state!=3:Rectangle {
        x:(parent.width - 48px)/2;y:(parent.height - 48px)/2;width:48px;height:48px;border-radius:24px;background:#0008;
        Image {x:13px;y:13px;width:22px;height:22px;source:root.state==1 ? @image-url("icons/photo-loading.svg") : root.state==4 ? @image-url("icons/photo-retry.svg") : @image-url("icons/play.svg");colorize:white;}
    }
    ContentTarget {
        width:parent.width;height:parent.height - (root.state==2 || root.state==3 ? 38px : 0px);
        label:root.state==1 ? @tr("Cancel video loading") : root.state==2 ? @tr("Pause video") : root.state==4 ? VideoPlayback.error : @tr("Play video");
        activated=>{root.control(root.state==1 ? 3 : 0,0);}
    }
    if root.state==2 || root.state==3:VideoControls {
        y:parent.height - self.height;width:parent.width;expanded:root.expanded;
        control(action,value)=>{root.control(action,value);}
    }
    if root.state!=2 && root.state!=3:Text {
        x:8px;y:parent.height - 25px;width:parent.width - 16px;height:21px;
        text:root.state==1 ? @tr("Loading…") : root.state==4 ? @tr("Unable to play · retry") : root.duration;
        color:white;font-size:11px;vertical-alignment:center;overflow:elide;
    }
}

export component VideoViewer inherits Rectangle {
    in property <int> message-id;
    callback control(int,float);
    callback closed();
    background:#10181ef8;
    TouchArea {}
    FocusScope {
        init=>{self.focus();}
        key-pressed(event)=>{
            if event.text==Key.Escape {root.closed();return accept;}
            if event.text==" " {root.control(0,0);return accept;}
            if event.text==Key.LeftArrow {root.control(1,max(0,VideoPlayback.fraction - 0.05));return accept;}
            if event.text==Key.RightArrow {root.control(1,min(1,VideoPlayback.fraction + 0.05));return accept;}
            return reject;
        }
        Text {x:20px;y:16px;width:parent.width - 80px;height:30px;text:@tr("Video");color:white;font-size:18px;font-weight:600;}
        VideoButton {x:parent.width - 46px;y:15px;kind:6;label:@tr("Back to message");activated=>{root.closed();}}
        VideoTile {
            x:16px;y:60px;width:parent.width - 32px;height:parent.height - 78px;
            message-id:root.message-id;expanded:true;
            control(action,value)=>{root.control(action,value);}
        }
    }
}
