import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconButton } from "components.slint";
import { SoftButton } from "settings.slint";
export struct MessageInfoRow {name:string,detail:string}

export component MessageDetails inherits Rectangle {
    in property <int> mode;
    in property <int> count:1;
    in property <bool> busy;
    in property <string> error;
    in property <string> summary;
    in-out property <string> text;
    in property <string> sent;
    in property <string> wire;
    in property <string> status;
    in property <[MessageInfoRow]> receipts;
    callback close();
    callback confirm();
    callback copy-id();
    background:#0005;
    TouchArea { }
    FocusScope {
        init=>{self.focus();}
        key-pressed(event)=>{
            if event.text==Key.Escape {if !root.busy {root.close();}return accept;}
            if event.text==Key.Return {
                if root.mode==5 && event.modifiers.control && !root.busy {root.confirm();}
                return accept;
            }
            return reject;
        }
        panel:=Rectangle {
            width:min(480px,root.width - 32px);
            height:min(root.mode==8 ? 460px : root.mode==5 ? 380px : 290px,root.height - 32px);
            x:(root.width - self.width)/2;y:(root.height - self.height)/2;
            background:Theme.overlay;border-radius:14px;
            drop-shadow-offset-y:8px;drop-shadow-blur:28px;drop-shadow-color:Theme.modal-shadow;
            TouchArea { }
            VerticalLayout {
                padding:20px;spacing:12px;
                HorizontalLayout {
                    height:28px;
                    Text {text:root.mode==5 ? @tr("Edit message") : root.mode==6 ? @tr("Delete for everyone?") : root.mode==7 ? @tr("Delete for me?") : @tr("Message info");color:Theme.text;font-size:19px;font-weight:600;vertical-alignment:center;horizontal-stretch:1;}
                    IconButton {icon:@image-url("icons/close.svg");label:@tr("Close message details");enabled:!root.busy;activated=>{root.close();}}
                }
                if root.mode!=5:Text {height:44px;text:root.summary;color:Theme.secondary;font-size:13px;wrap:word-wrap;overflow:elide;max-lines:2;}
                if root.mode==5:Rectangle {
                    vertical-stretch:1;background:Theme.surface;border-radius:8px;border-width:1px;border-color:Theme.outline;
                    FocusScope {
                        init=>{edit-field.focus();}
                        Flickable {
                            x:10px;y:10px;width:parent.width - 20px;height:parent.height - 20px;
                            content-width:self.width;content-height:max(self.height,edit-field.preferred-height);
                            edit-field:=TextInput {width:parent.width;height:max(parent.height,self.preferred-height);text<=>root.text;enabled:!root.busy;color:Theme.text;wrap:word-wrap;font-size:14px;accessible-label:@tr("Edited message text");
                                cursor-position-changed(pos)=>{if pos.y+parent.content-y<0px {parent.content-y=-pos.y;}else if pos.y+20px+parent.content-y>parent.height {parent.content-y=parent.height - pos.y - 20px;}}
                            }
                        }
                    }
                }
                if root.mode==6 || root.mode==7:Text {
                    vertical-stretch:1;text:root.mode==6 ? @tr("This message will be deleted for everyone in this conversation.") : root.count==1 ? @tr("This message will be removed for you and synced to your linked devices. Other participants keep their copies.") : @tr("These {} messages will be removed for you and synced to your linked devices. Other participants keep their copies.",root.count);
                    color:Theme.text;wrap:word-wrap;font-size:14px;
                }
                if root.mode==8:Text {text:@tr("Sent · {}",root.sent)+"\n"+root.status;color:Theme.secondary;wrap:word-wrap;font-size:13px;}
                if root.mode==8 && root.receipts.length==0:Text {text:@tr("Recipient receipt times have not been supplied. Unavailable read receipts do not mean the message is unread.");color:Theme.secondary;wrap:word-wrap;font-size:13px;vertical-stretch:1;}
                if root.mode==8 && root.receipts.length>0:ListView {
                    for receipt in root.receipts:Rectangle {
                        height:88px;
                        Text {x:0px;y:6px;width:parent.width;height:20px;text:receipt.name;color:Theme.text;font-size:14px;overflow:elide;}
                        Text {x:0px;y:29px;width:parent.width;height:54px;text:receipt.detail;color:Theme.secondary;font-size:12px;wrap:word-wrap;overflow:elide;}
                    }
                }
                if root.error!="":Text {text:root.error;color:Theme.secondary;wrap:word-wrap;font-size:12px;}
                if root.mode==8:HorizontalLayout {alignment:end;height:32px;SoftButton{text:@tr("Copy message ID");enabled:!root.busy && root.wire!="";activated=>{root.copy-id();}}}
                if root.mode!=8:HorizontalLayout {
                    alignment:end;spacing:10px;height:32px;
                    SoftButton {text:@tr("Cancel");enabled:!root.busy;activated=>{root.close();}}
                    SoftButton {text:root.busy ? @tr("Please wait…") : root.mode==5 ? @tr("Save edit") : root.mode==6 ? @tr("Delete for everyone") : @tr("Delete for me");enabled:!root.busy;activated=>{root.confirm();}}
                }
            }
        }
    }
}

export component SelectionBar inherits Rectangle {
    in property <int> count;
    in property <bool> busy;
    callback control(int);
    height:56px;background:Theme.panel;
    HorizontalLayout {
        padding:8px;spacing:8px;
        IconButton {icon:@image-url("icons/close.svg");label:@tr("Cancel selection");activated=>{root.control(0);}}
        Text {text:@tr("{} selected",root.count);color:Theme.text;vertical-alignment:center;horizontal-stretch:1;}
        IconButton {icon:@image-url("icons/copy.svg");label:@tr("Copy selected messages");enabled:root.count>0&&!root.busy;activated=>{root.control(1);}}
        IconButton {icon:@image-url("icons/trash.svg");label:@tr("Delete selected messages for me");enabled:root.count>0&&!root.busy;activated=>{root.control(3);}}
        SoftButton {text:@tr("Forward…");enabled:root.count>0&&!root.busy;activated=>{root.control(2);}}
    }
}
