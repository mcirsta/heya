import { Theme } from "theme.slint";
import { Avatar, IconButton } from "components.slint";
import { SoftButton } from "settings.slint";
import { ContentTarget } from "message-content.slint";
import { ListView, ScrollView } from "std-widgets.slint";

export struct SharedContactRow { name:string, initials:string, account:string, details:string }

export component SharedContactCard inherits Rectangle {
    in property <string> name;
    in property <string> initials;
    in property <string> number;
    in property <int> count;
    in property <image> picture;
    in property <bool> can-message;
    callback activate(int);
    height:112px;
    Avatar {x:12px;y:12px;width:44px;height:44px;initials:root.initials;picture:root.picture;tint:Theme.accent;}
    Text {x:70px;y:12px;width:max(0px,parent.width - 82px);height:24px;text:root.name;font-size:16px;font-weight:600;color:Theme.text;overflow:elide;}
    Text {x:70px;y:38px;width:max(0px,parent.width - 82px);height:22px;text:root.count>1 ? @tr("{} contacts",root.count) : root.number;color:Theme.secondary;font-size:13px;overflow:elide;}
    ContentTarget {x:0px;y:0px;width:parent.width;height:74px;label:root.count>1 ? @tr("View contacts") : @tr("View contact");activated=>{root.activate(-30);}}
    Rectangle {y:74px;width:parent.width;height:1px;background:Theme.outline;}
    if root.count==1 && root.can-message:message-button:=Rectangle {
        x:0px;y:75px;width:parent.width/2;height:36px;
        Text {width:parent.width;height:parent.height;text:@tr("Message");font-size:14px;color:Theme.link;horizontal-alignment:center;vertical-alignment:center;}
        ContentTarget {label:@tr("Message contact");activated=>{root.activate(-31);}}
    }
    view-button:=Rectangle {
        x:root.count==1 && root.can-message ? parent.width/2 : 0px;y:75px;
        width:root.count==1 && root.can-message ? parent.width/2 : parent.width;height:36px;
        Text {width:parent.width;height:parent.height;text:root.count>1 ? @tr("View all") : @tr("View contact");font-size:14px;color:Theme.link;horizontal-alignment:center;vertical-alignment:center;}
        ContentTarget {label:root.count>1 ? @tr("View all contacts") : @tr("View contact");activated=>{root.activate(-30);}}
    }
}

export component SharedContactsDialog inherits Rectangle {
    in property <[SharedContactRow]> contacts;
    in-out property <int> selected:-1;
    in property <bool> available;
    callback close();
    callback action(int,int);
    background:#0008;
    TouchArea {clicked=>{root.close();}}
    FocusScope {
        init=>{self.focus();}
        key-pressed(e)=>{if e.text==Key.Escape {root.close();return accept;}return reject;}
        panel:=Rectangle {
            x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;
            width:min(480px,parent.width - 32px);height:min(640px,parent.height - 40px);
            background:Theme.panel;border-radius:14px;drop-shadow-blur:32px;drop-shadow-color:Theme.modal-shadow;
            TouchArea {}
            header:=Rectangle {x:0px;y:0px;height:66px;width:parent.width;
                if root.selected>=0 && root.contacts.length>1:IconButton {x:10px;y:15px;icon:@image-url("icons/back.svg");label:@tr("Back to contacts");activated=>{root.selected=-1;}}
                Text {x:root.selected>=0 && root.contacts.length>1 ? 52px : 24px;y:0px;width:parent.width - self.x - 60px;height:66px;text:root.selected<0 ? @tr("Contacts") : @tr("Contact details");font-size:20px;font-weight:600;color:Theme.text;vertical-alignment:center;}
                IconButton {x:parent.width - 48px;y:15px;icon:@image-url("icons/close.svg");label:@tr("Close contact details");activated=>{root.close();}}
            }
            if root.selected<0:ListView {
                x:12px;y:66px;width:parent.width - 24px;height:parent.height - 122px;
                for person[index] in root.contacts:Rectangle {
                    height:78px;background:transparent;border-radius:8px;
                    Avatar {x:12px;y:13px;width:48px;height:48px;initials:person.initials;tint:Theme.accent;}
                    Text {x:76px;y:13px;width:parent.width - 90px;height:26px;text:person.name;color:Theme.text;font-size:16px;overflow:elide;}
                    Text {x:76px;y:42px;width:parent.width - 90px;height:22px;text:person.account!="" ? "+" + person.account : @tr("View contact details");color:Theme.secondary;font-size:13px;overflow:elide;}
                    hit:=ContentTarget {label:person.name;activated=>{root.selected=index;}}
                }
            }
            if root.selected>=0 && root.selected<root.contacts.length:ScrollView {
                x:24px;y:70px;width:parent.width - 48px;height:parent.height - 142px;
                horizontal-scrollbar-policy:always-off;
                VerticalLayout {
                    padding:0px;spacing:16px;alignment:start;
                    Rectangle {height:96px;Avatar {x:(parent.width - 80px)/2;y:0px;width:80px;height:80px;initials:root.contacts[root.selected].initials;tint:Theme.accent;}}
                    Text {text:root.contacts[root.selected].name;color:Theme.text;font-size:22px;font-weight:600;wrap:word-wrap;horizontal-alignment:center;}
                    if root.contacts[root.selected].account!="":SoftButton {text:@tr("Message");enabled:root.available;activated=>{root.action(root.selected,1);}}
                    TextInput {text:root.contacts[root.selected].details;color:Theme.text;font-size:14px;read-only:true;single-line:false;wrap:word-wrap;selection-background-color:Theme.accent;selection-foreground-color:Theme.on-accent;accessible-label:@tr("Contact details");}
                    SoftButton {text:@tr("Copy details");activated=>{root.action(root.selected,2);}}
                }
            }
            SoftButton {x:24px;y:parent.height - 52px;width:parent.width - 48px;text:root.contacts.length>1 ? @tr("Save contact files…") : @tr("Save contact file…");activated=>{root.action(0,3);}}
        }
    }
}
