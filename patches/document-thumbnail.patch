     #[test]
+    fn document_thumbnail_uses_its_own_hkdf_context_and_authenticated_payload() {
+        let key: [u8; 32] = std::array::from_fn(|i| i as u8);
+        let media_type = MediaType::DocumentThumbnail;
+        let mut expanded = [0; 112];
+        crate::crypto::hkdf_sha256_into(
+            &key,
+            None,
+            media_type.app_info().as_bytes(),
+            &mut expanded,
+        )
+        .unwrap();
+        // RFC 5869 SHA-256 vector generated independently with Python hmac.
+        let expected = hex::decode("97f084f7ac45e4de4ed47610f986b2ae0ec30cc02f6b04b112132431b7cf5155b4c91ceacf9d86357bde55fd6b0a77e59bd4e48c5806115a5dbae07b9a7b08dcd7e206e4f93ffde958e00cb88dd2b6fe65e8cb67b413c290a5608be544c92147838583cad2ff52915a9837a9196eaa99").unwrap();
+        assert_eq!(expanded.as_slice(), expected);
+        assert_eq!(media_type.mms_type(), "thumbnail-document");
+        assert_eq!(media_type.upload_path(), "/mms/thumbnail-document");
+        let plain = b"synthetic document preview";
+        let enc = crate::upload::encrypt_media_with_key(plain, media_type, Some(&key)).unwrap();
+        let mut payload = enc.data_to_upload.clone();
+        DownloadUtils::verify_and_decrypt_in_place_with_hashes(
+            &mut payload,
+            &key,
+            media_type,
+            Some(&enc.file_enc_sha256),
+            Some(&enc.file_sha256),
+        )
+        .unwrap();
+        assert_eq!(payload, plain);
+        assert!(
+            DownloadUtils::verify_and_decrypt(&enc.data_to_upload, &key, MediaType::Document)
+                .is_err()
+        );
+        let mut corrupt = enc.data_to_upload;
+        corrupt[0] ^= 1;
+        assert!(DownloadUtils::verify_and_decrypt(&corrupt, &key, media_type).is_err());
+    }
