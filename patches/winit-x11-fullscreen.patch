+    // The WM can change borderless fullscreen without set_fullscreen() being
+    // called (for example through its keyboard shortcut or window menu).
+    pub(crate) fn sync_wm_fullscreen(&self) -> bool {
+        let atoms = self.xconn.atoms();
+        let Ok(state) = self.xconn.get_property::<xproto::Atom>(
+            self.xwindow,
+            atoms[_NET_WM_STATE],
+            xproto::AtomEnum::ATOM.into(),
+        ) else {
+            return false;
+        };
+        let fullscreen = state.contains(&atoms[_NET_WM_STATE_FULLSCREEN]);
+        let mut shared = self.shared_state_lock();
+        // Exclusive mode also owns a display mode; leave that lifecycle with
+        // set_fullscreen_inner rather than discarding its restoration data.
+        if matches!(shared.fullscreen, Some(Fullscreen::Exclusive(..)))
+            || shared.desired_fullscreen.is_some()
+            || fullscreen == shared.fullscreen.is_some()
+        {
+            return false;
+        }
+        shared.fullscreen = fullscreen.then_some(Fullscreen::Borderless(None));
+        true
+    }
