+    /// What the writer puts on the wire is what WA Web writes, and the reader
+    /// turns it back into the same call, placed by this account.
+    #[tokio::test]
+    async fn a_written_call_log_reads_back_as_the_same_placed_call() {
+        let creator: Jid = OWN_LID.parse().unwrap();
+        let record = {
+            let mut proto = wa::CallLogRecord::default();
+            proto.call_id = Some("call-77".into());
+            proto.call_result = Some(wa::call_log_record::CallResult::CONNECTED);
+            proto.duration = Some(64);
+            proto.start_time = Some(1_700_000_000);
+            proto.participants.push({
+                let mut peer = wa::call_log_record::ParticipantInfo::default();
+                peer.user_jid = Some(PEER.into());
+                peer
+            });
+            proto
+        };
+        let sent = record.clone();
+        let mutation = crate::features::chat_actions::capture_app_state_mutation(
+            schemas::CALL_LOG.collection.as_str(),
+            move |client| async move { client.send_call_log(&creator, "call-77", true, sent).await },
+        )
+        .await;
+
+        assert_eq!(mutation.operation, wa::syncd_mutation::SyncdOperation::Set);
+        assert_eq!(mutation.index, ["call_log", OWN_LID, "call-77", "1"]);
+        assert!(
+            mutation
+                .action_value
+                .as_ref()
+                .and_then(|value| value.timestamp)
+                .is_some_and(|ms| ms > 1_700_000_000_000)
+        );
+        let (outcome, events) = dispatch(&mutation, false);
+        assert_eq!(outcome, AppStateDispatchOutcome::Event("CallLogSync"));
+        let Event::CallLogSync(update) = events[0].as_ref() else {
+            panic!("expected CallLogSync event");
+        };
+        assert!(update.from_me);
+        assert_eq!(update.call_id, "call-77");
+        assert_eq!(update.call_creator_jid.to_string(), OWN_LID);
+        assert_eq!(*update.record, record);
+    }
+
