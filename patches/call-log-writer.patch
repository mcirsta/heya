+/// The index WA Web's `getCallLogMutation` writes:
+/// `["call_log", callCreatorJid, callId, fromMe ? "1" : "0"]`. The registry
+/// declares only the literal, so [`Client::send_app_state_action`] would put
+/// every call on the same index.
+fn call_log_index(call_creator: &Jid, call_id: &str, from_me: bool) -> anyhow::Result<Vec<u8>> {
+    let creator = call_creator.to_string();
+    let direction = if from_me { "1" } else { "0" };
+    Ok(serde_json::to_vec(&[
+        schemas::CALL_LOG.name,
+        creator.as_str(),
+        call_id,
+        direction,
+    ])?)
+}
+
+impl crate::client::Client {
+    /// Publish one call to the account's call history (`call_log` in the
+    /// `regular` collection), so the primary device and other companions list
+    /// it. The record is sent as given; the mutation timestamp is now.
+    ///
+    /// `call_creator` is the call's creator as it appeared in signaling (this
+    /// account for a call it placed), which readers compare against their own
+    /// identities to tell direction. `from_me` sets the index's direction flag
+    /// as WA Web does.
+    pub async fn send_call_log(
+        &self,
+        call_creator: &Jid,
+        call_id: &str,
+        from_me: bool,
+        record: wa::CallLogRecord,
+    ) -> Result<(), crate::AppStateError> {
+        if call_id.is_empty() {
+            return Err(crate::AppStateError::InvalidRequest(
+                "call log needs a call id".into(),
+            ));
+        }
+        let index = call_log_index(call_creator, call_id, from_me)?;
+        let mut value = wa::SyncActionValue::default();
+        value.timestamp = Some(wacore::time::now_millis());
+        value.call_log_action = buffa::MessageField::some({
+            let mut action = wa::sync_action_value::CallLogAction::default();
+            action.call_log_record = buffa::MessageField::some(record);
+            action
+        });
+        self.send_app_state_mutation(
+            schemas::CALL_LOG.collection.as_str(),
+            &index,
+            &value,
+            schemas::CALL_LOG.version as i32,
+            wa::syncd_mutation::SyncdOperation::SET,
+        )
+        .await
+    }
+}
