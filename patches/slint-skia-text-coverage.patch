 use itemrenderer::to_skia_rect;
 pub use skia_safe;
+
+// Linux desktop text uses unmodified grayscale coverage. Skia's default
+// contrast/gamma correction makes dark text lighter on our sRGB surfaces.
+// Set this once per surface; child/layer surfaces inherit these properties.
+fn text_surface_props() -> Option<skia_safe::SurfaceProps> {
+    #[cfg(target_os = "linux")]
+    {
+        Some(skia_safe::SurfaceProps::new_with_text_properties(
+            Default::default(),
+            Default::default(),
+            0.0,
+            1.0,
+        ))
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        None
+    }
+}
 
